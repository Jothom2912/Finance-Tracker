# Budget Service environment variables
# Copy this file to .env and fill in the values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/budget_service
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Skal matche den nøgle resten af stakken kører med — hent værdien fra
# repo-roddens .env. Bevidst tom: en committet default her ville blive
# den nye fælles literal (P2-26).
JWT_SECRET=
JWT_ALGORITHM=HS256
ENVIRONMENT=development
LOG_LEVEL=INFO
CATEGORY_SERVICE_URL=http://localhost:8005
