# =============================================================================
# Categorization Service Configuration
# =============================================================================

# PostgreSQL connection (required)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://categorization_service:categorization_service_pass@localhost:5435/categorization

# RabbitMQ connection (required for event consumption/production)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT verification (must match user-service issuer)
# Skal matche den nøgle resten af stakken kører med — hent værdien fra
# repo-roddens .env. Bevidst tom: en committet default her ville blive
# den nye fælles literal (P2-26).
JWT_SECRET=
JWT_ALGORITHM=HS256

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
