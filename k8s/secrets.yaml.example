# Template. Kopiér til k8s/secrets.yaml (gitignored) og udfyld de tre
# tomme felter før `kubectl apply -k k8s/`.
#
#   cp k8s/secrets.yaml.example k8s/secrets.yaml
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # INTERNAL_API_KEY
#
# Eller brug scripts/k8s-up.sh, som fejler med en brugbar besked hvis
# filen mangler.
#
# JWT_SECRET og SECRET_KEY skal have SAMME værdi: det er én delt HS256-nøgle,
# og gateway-service læser den blot under det historiske navn SECRET_KEY.
# Divergerer de, verificerer gateway tokens ingen anden service kan udstede.
#
# Kun de tre auth-nøgler er tomme her. DB-URL'erne matcher de passwords
# k8s/infra/ selv sætter, så de er ikke hemmeligheder i praksis — at flytte
# dem hører under P2-15 (SOPS/secretGenerator) og P3-24, ikke her.
#
# ENABLE_BANKING_APP_ID beholder sin værdi med vilje: det er *sandbox*-id'et,
# og et frisk clone skal kunne køre banking ud af boksen — samme rationale som
# compose-defaulten. Produktions-id'et ligger kun i utracket .env og hører
# ikke i denne fil. Den private PEM er gitignored (*.pem) og skabes som en
# separat secret out-of-band af scripts/k8s-up.sh.
apiVersion: v1
kind: Secret
metadata:
  name: finance-tracker-secrets
  namespace: finance-tracker
type: Opaque
stringData:
  JWT_SECRET: ""
  SECRET_KEY: ""
  INTERNAL_API_KEY: ""
  RABBITMQ_URL: "amqp://guest:guest@rabbitmq:5672/"
  DATABASE_URL_USER: "postgresql+asyncpg://user_service:user_service_pass@postgres:5432/users"
  DATABASE_URL_TRANSACTION: "postgresql+asyncpg://transaction_service:transaction_service_pass@postgres-transactions:5432/transactions"
  DATABASE_URL_TRANSACTION_SYNC: "postgresql+psycopg2://transaction_service:transaction_service_pass@postgres-transactions:5432/transactions"
  DATABASE_URL_ACCOUNT_SYNC: "postgresql+psycopg2://account_user:account_password@postgres-account:5432/account_db"
  DATABASE_URL_ACCOUNT_ASYNC: "postgresql+asyncpg://account_user:account_password@postgres-account:5432/account_db"
  DATABASE_URL_BANKING: "postgresql+asyncpg://banking_service:banking_service_pass@postgres-banking:5432/banking_db"
  DATABASE_URL_CATEGORIZATION: "postgresql+asyncpg://categorization_service:categorization_service_pass@postgres-categorization:5432/categorization"
  DATABASE_URL_BUDGET: "postgresql+asyncpg://budget_service:budget_service_pass@postgres-budget:5432/budget_service"
  DATABASE_URL_GOAL: "postgresql+asyncpg://goal_service:goal_service_pass@postgres-goals:5432/goals"
  DATABASE_URL_SAGA: "postgresql+asyncpg://saga_service:saga_service_pass@postgres-saga:5432/saga"
  DATABASE_URL_NOTIFICATION: "postgresql+asyncpg://notification_service:notification_service_pass@postgres-notifications:5432/notifications"
  DATABASE_URL_NOTIFICATION_SYNC: "postgresql+psycopg2://notification_service:notification_service_pass@postgres-notifications:5432/notifications"
  ENABLE_BANKING_APP_ID: "4fc48bf2-4d73-41e6-a76c-3fcce9ffe9a7"
